#!/sbin/openrc-run
description="vigie : métadonnées du service OpenStack (169.254.169.254), si aucune source locale"

depend() {
	need net
	after vigie
	before vigie-issue
}

start() {
	[ "$(cat /run/vigie/platform 2>/dev/null)" = kvm ] || return 0
	[ -e /run/vigie/cloud-local ] && return 0
	ebegin "vigie : métadonnées d'instance (service OpenStack)"
	/usr/bin/vigie cloud apply -data /data/vigie -url http://169.254.169.254 >/dev/null 2>&1
	/usr/lib/vigie/update-issue
	eend 0
}
